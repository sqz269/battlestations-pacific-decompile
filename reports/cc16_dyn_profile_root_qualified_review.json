  "source_review": {
    "required_provider": "Separate DynProfileRootPartialNodeDelete flat cdecl(void*) alias; no default/global/native-code-pointer cast/context thunk. Null provider rejected before caller profile/context access.",
    "layout": "No context/storage fields changed; separate alias avoids engine-to-scope include cycle.",
    "allocate": "Actual48h context.memory allocation occurs outside try, before acquired captured cleanup.",
    "capture": "Original raw allocation is const-captured and is the only free identity; current heads, publication and constructor return are never substituted.",
    "dependency": "Real qualified4arg C44000 receives actual context.memory; its existing A900 current-vector conditional BF6989 release runs before outer Root captured BF65AC release/rethrow.",
    "covered_source": [
      "conditional qualified C44000",
      "head+0",
      "head+4",
      "word+8=0",
      "actual profile publication",
      "existing std::memset(profile+C,0,90)",
      "return incoming profile"
    ],
    "null_allocation": "Skip constructor, retain null heads and normal incoming-profile publication/tail clear. No allocator fallback introduced; later covered cleanup passes original null unchanged.",
    "interruption": "No head/publication clear, unregister, current-node reload, retry or rollback. Reached state may retain a freed node and requires genuine outer failure/lifetime custody.",
    "old_APIs": "Old2argRoot, both old C44000 APIs and C55EA0/C55F50 remain unchanged; enclosing engine callers select old normal-only Root.",
    "heap": "Opaque/custom memory.release (BF6989 vector service) is not authenticated as flat raw-node BF65AC. Nonnull provider is insufficient to qualify arbitrary context custody."
  },
