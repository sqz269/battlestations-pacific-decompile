    "source": "from pathlib import Path\nimport json,subprocess,sys,hashlib\n# Run from a repository sharing commit8f9; choose a NEW ignored directory.\nrepo=Path.cwd();out=Path(sys.argv[1]).resolve();assert not out.exists();out.mkdir(parents=True);(out/'local/output').mkdir(parents=True)\ncommit='8f9f9942bfc3bd8f23d385f6269d01375b72511b'\nr=json.loads(subprocess.check_output(['git','show',commit+':reports/cc16_native_gui_text_failure_origin_host_slice.json']))\nbaseline={}\nfor p in r['mechanical_inverse']['baseline_GitLF_inputs']:\n b=subprocess.check_output(['git','cat-file','blob',p['git_blob_oid']]);assert hashlib.sha256(b).hexdigest()==p['sha256'];baseline[p['path']]={'content':b.decode(),'sha256':p['sha256'],'git_blob':p['git_blob_oid']}\n q=out/p['path'];q.parent.mkdir(parents=True,exist_ok=True);q.write_bytes(subprocess.check_output(['git','show',commit+':'+p['path']]))\n(out/'local/output/failure_origin_host_slice_baseline.json').write_text(json.dumps(baseline))\n(out/'local/output/failure_origin_changed_seams.json').write_text(json.dumps(r['mechanical_inverse']['changed_seam_data']))\n(out/'local/output/failure_origin_prefix_assertions.txt').write_text(r['prefix_assertions'])\nfor i,s in enumerate(r['mechanical_inverse']['scripts']):\n p=out/('embedded_'+str(i)+'.py');p.write_bytes(s['source'].encode('utf-8'));subprocess.run([sys.executable,str(p)],cwd=out,check=True,timeout=10)\n",
