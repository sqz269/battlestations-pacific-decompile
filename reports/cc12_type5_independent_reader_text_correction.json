  "changes": [
    {
      "module": "raw_formats",
      "finding": "COFF rawptr==0 synthesized zero bytes; executable body slicing could mask absent raw backing.",
      "correction": "Retain declared section size with empty raw bytes and explicit raw_pointer/raw_file_size. Bound section/symbol/aux/string/relocation tables and primary indices. Require positive, complete raw executable extents and disallow overlapping entry extents.",
      "limitation": "Only text/AST reviewed; no COFF fixture or parser function was run."
    },
    {
      "module": "raw_formats/code_gate",
      "finding": "Unretained weak symbols validated only their first TagIndex.",
      "correction": "Walk every complete primary-symbol weak chain with per-node aux shape, supported SEARCH_NOLIBRARY=1/SEARCH_ALIAS=3, bounded TagIndex, cycle rejection and a defined terminal. Retained code still requires complete bytes/relocations and same-VA aliases.",
      "limitation": "Neither weak mode is claimed as empirically observed or exercised by this text-only correction."
    },
    {
      "module": "code_gate",
      "finding": "Helper starts accepted arbitrary MAP labels; padding checks did not enforce the selected complete helper gaps.",
      "correction": "Require real MAP f ownership and next same-section MAP f boundary, excluding internal cs10 labels; require full executable raw backing. Preserve stack43+5 alignment, cookie14+2 alignment and unsized-delete5+11 alignment; sized delete remains16 and free thunk6.",
      "limitation": "Any different actual helper shape must stop for explicit evidence review, not be trimmed to a guessed last RET."
    },
    {
      "module": "code_gate",
      "finding": "Every non-CxxThrow INT3 was rejected, and unreachable end fallthrough could fail before reachability was known.",
      "correction": "Defer fallout rejection to reachable instructions; derive the maximal contiguous unreachable trailing NOP/INT3 suffix with a reachable RET/JMP/proved-CxxThrow boundary. Classify the actual immediate post-CxxThrow guard separately. Keep all original TU gate bytes and full instruction listings.",
      "limitation": "Reachable traps, UD2 and other unreachable non-NOP instructions still stop. Cold byte coverage does not imply EH execution."
    },
    {
      "module": "observations/raw_formats",
      "finding": "Saved-observation decoding opened installed provider DLLs and queried fresh WinAPI file identity.",
      "correction": "Decode only the contained frozen file selected by exact original/frozen pin pairs in frozen_inputs.json. Compare static identity.physical_NT_path with runtime mapped_path; validate original-generation packed identity as metadata. Remove ctypes and disk_identity.",
      "limitation": "No copy FileID or new live provider attestation is substituted for the original-generation metadata."
    },
    {
      "module": "observations/raw_formats",
      "finding": "Observation parsing did not bind runtime, static, frozen, stdout, exit and args to exactly parsed bytes.",
      "correction": "Cache and pin every exact parser input; pass cached bytes through optional PE/read_gate raw_bytes arguments; bind static EXE/Gate pins, runtime versus stdout, zero exit, sole fresh-EXE args/cwd and empty stderr; recheck all cached bytes unchanged.",
      "limitation": "These checks are unexecuted text and do not accept a future Root receipt or authorize a process."
    }
  ],
