 "corrections": [
  {
   "target": "docs/GUN_CLASS_FAMILY.md",
   "was": "MMultipleBombPlatform 21h, MRFSGun 23h, MRTGun 24h, MSTGun 27h",
   "is": "MRFSGun 21h, MRTGun 23h, MSTGun 24h, MBombPlatform 25h, MMultipleBombPlatform 26h, MDepthChargeLauncher 27h, MCatapult 28h",
   "evidence": "The class-descriptor record's creator is the dword IMMEDIATELY BEFORE the inline name, not the one before the next name. Seven scene-table ids settle the direction: MLandFort 1Bh, MCommandBuilding 1Ch, MWaterMine 34h, MAirfield 45h, MShipyard 46h, LandConvoy 1Ah, PlaneSquadronGen 18h all match the literal PUSH pairs of 004F2800 under this direction and are off by one record under the other. 20h stays the base gun, so vtable[5Ch](20h) is unaffected."
  },
  {
   "target": "docs/UNIT_INSTANCE_LAYOUT.md",
   "was": "+C4h is written once per level with the level's own depth",
   "is": "+C4h holds the most derived class id; depth and id merely coincide on the ship chain",
   "evidence": "The destroyer's levels write 01, 02, 04, 05, 06, 07 and skip 03, which is its own class (test 00888EA0, vtable 00D11138, parent 01). The chain compiled into 006FE530 is 07, 06, 05, 04, 02, 01, 0 with no 03."
  },
  {
   "target": "docs/SCENE_ENTITY_FACTORY.md",
   "was": "19h is not a registered class id at all, a leftover of a class removed before release",
   "is": "19h is MLandVehicle, a live class with its own test 0074DD90 and vtable 00CFFDE0; it is simply not scene-registered, because land vehicles come from LandConvoy",
   "evidence": "Class-descriptor record MLandVehicle at 00D1AA44, creator 0074DF10, whose constructor chain stamps 04h, 05h, 19h. 1Fh is the id with no attestation at all: no class test and no constructor stamp."
  },
  {
   "target": "ledger 007004B0",
   "was": "BSP_DummyTargetInstance_IsKindOf (packet cc_unit_lists)",
   "is": "BSP_ClassId35_IsKindOf",
   "evidence": "The chain at 007004B0 is 35h, 05h, 04h, 02h, 01h, 0, a unit subclass under 05h; that packet's own evidence text already recorded it. The dummy-target class is 2Eh and its test is 00700AC0 with chain 2Eh, 2Dh, 2Ah, 02h, 01h, 0."
  }
 ],
 "routines": [],
 "is_kind_of_rule": {
  "form": "query on the owning class's compiled ancestor chain, OR query == the dword at +C4h",
  "not": [
   "equality",
   "range test",
   "run-time chain walk"
  ],
  "abi": "__thiscall, one stack argument, RET 4, returns 0 or 1 in EAX",
  "vtable_slot": "5Ch",
  "field": "+C4h, the most derived class id",
  "inherited_case": "SimpleEffect 5Bh (vtable 00CE8BD0) and PeriodicEffect 5Ch (00CE8D68) install class 01h's test 0047F190; 00D19500 installs the root's 0042B8F0. Their own identity is answered only by the +C4h compare."
 },
 "kind_to_class_id": {
  "rule": "entity-lookup bucket index = class id - 6",
  "evidence": "0088B1D8 MOV EBX,0FFFFFFFAh for the first bucket, 0088B2CA CMP EBX,5Bh for the last, so the array spans class ids 0..60h; 60h is the highest id with a class test (007810F0)."
 },
