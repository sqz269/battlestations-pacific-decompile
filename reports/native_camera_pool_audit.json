  "shared_contracts": {
    "allocator_list": "One canonical AllocatorListDomain takes the actual E188B4 head reference. Before initialization publishes the owner, bind native D62CE0/B716D0 to this companion and concrete trim. No placeholder foreign allocator profile.",
    "allocation": "singleton_lifetime_allocate uses actual CRT malloc/new-handler retry and throws bad_alloc when the handler refuses. Native BF55BE forwards to BF681B; table allocation uses pointer_slots/native capacity*4; slab allocation uses object/8BC4.",
    "free": "singleton_lifetime_free uses real CRT free. Native BF6989 forwards to BF65AC.",
    "critical_section": "Actual Win32 Initialize/Enter/Leave/DeleteCriticalSection over supplied +0C bytes. Explicit recursion +24 increments/decrements modulo 32 bits on allocation and return.",
    "static_lifetime": "Caller must bind actual stable owner, domain and companion before startup. Startup is explicit once, calls native owner initialization and actual std::atexit by default; supplied real registration result is returned. Failure to register does not undo construction. C++ companion destruction does not run native cleanup."
  },
  "ordering_and_continuations": {
    "constructor": "Base allocator prepend, pool vtable, actual section initialization, recursion/slab words initialization, first_free FFFFFFFF, capacity32 publication, real 128-byte table allocation, current pointer copy/free, replacement publication.",
    "allocation": "Enter actual section; explicit recursion increment; publish first_free=count before slab allocation; if full table publish capacity*2+2 before allocating/copying/freeing; append real slab pointer; pop free index; scan later slabs if now full; decrement recursion then leave.",
    "return": "Enter section; increment recursion; load actual slot+458 ID and current table entry; signed difference /45C (native IMUL 3AB95901 and SAR8), push low16 index and increment count; update minimum first_free; decrement recursion then leave.",
    "trim": "No lock; free empty slab; copy last table pointer into hole; decrement count; rewrite every moved ID; retry same index; recompute first_free. Retain pointer-table allocation/capacity.",
