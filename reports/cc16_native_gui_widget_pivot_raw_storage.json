  "reader_py": "import base64,hashlib,json,pathlib,subprocess,sys\np=pathlib.Path(sys.argv[1]);r=json.loads(p.read_text(encoding=\"utf-8\"));rev=sys.argv[2] if len(sys.argv)>2 else None\nsha=lambda b:hashlib.sha256(b).hexdigest()\ngit=lambda spec:subprocess.check_output([\"git\",\"show\",spec])\nold={};new={}\nfor f in r[\"source_files\"]:\n q=f[\"path\"];b=base64.b64decode(f[\"baseline_base64\"]);assert git(r[\"base_commit\"]+\":\"+q)==b\n assert sha(b)==f[\"before\"][\"sha256\"]\n frozen=pathlib.Path(f[\"frozen_before\"])\n if frozen.exists():assert frozen.read_bytes()==b\n old[q]=b;new[q]=git(rev+\":\"+q) if rev else pathlib.Path(q).read_bytes()\n assert sha(new[q])==f[\"after\"][\"sha256\"]\nstate=old.copy();stages=iter(r[\"intermediate_states\"])\ndef check_state():\n w=next(stages);h={q:sha(b) for q,b in sorted(state.items())}\n assert h==w[\"file_sha256\"] and sha(json.dumps(h,sort_keys=True,separators=(\",\",\":\")).encode())==w[\"canonical_hash_map_sha256\"]\ncheck_state()\nfor s in r[\"seams\"]:\n q=s[\"path\"];a=s[\"byte_offset\"];b=base64.b64decode(s[\"inserted_base64\"]);assert sha(b)==s[\"inserted\"][\"sha256\"]\n assert state[q][a:]==base64.b64decode(s[\"anchor_base64\"])\n state[q]=state[q][:a]+b+state[q][a:]\n check_state()\nassert state==new\nfor s in reversed(r[\"seams\"]):\n q=s[\"path\"];a=s[\"byte_offset\"];b=base64.b64decode(s[\"inserted_base64\"]);assert state[q][a:a+len(b)]==b\n state[q]=state[q][:a]+state[q][a+len(b):]\n check_state()\nassert state==old\nassert not list(stages)\nfor w in r[\"whole_file_witnesses\"]:\n q=w[\"path\"];b=git(r[\"base_commit\"]+\":\"+q);a=git(rev+\":\"+q) if rev else pathlib.Path(q).read_bytes()\n assert a==b and sha(b)==w[\"sha256\"]\n frozen=pathlib.Path(w[\"frozen\"])\n if frozen.exists():assert frozen.read_bytes()==b\nprint(\"PASS: two forward/reverse whole-file inverses; Git/raw/frozen preimages; unchanged whole-file witnesses\")\n"
