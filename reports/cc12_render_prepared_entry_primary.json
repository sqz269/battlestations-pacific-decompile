  "contract": {
    "prepare": "Validate raw nonnull/aligned opaque identity, insert one null metadata entry under a short lock; do not read Native +04.",
    "token": "Move-only registry/key/stable mapped-value address. Registry outlives token; no pending-key erase/extract/replacement. Move/cancel cleans only its own still-null entry.",
    "publish": "Verify exact registry/key/mapped-value/null state before Native +04 alias and positive-count validation; fill existing entry and consume token. No insert, retain/release, constructor or Native callback.",
    "failure": "Publication is not noexcept: mutex acquisition can throw. Invalid capability/alias/count terminates. noexcept cancel makes mutex failure fatal.",
    "existing": "Ordinary bind/unbind/find/resolve/size/empty and callback Source bodies unchanged; enclosing instance storage unchanged.",
    "pending": "Pending entries count in size, find returns null and resolve rejects until publication."
  },
