    {"id": "failure_records", "evidence": "supervisor:217-232", "finding": "An unsuccessful record may contain missing final accounting. That record is retained as failure evidence and does not establish closure."},
    {"id": "argv_ENV_cwd", "evidence": "supervisor:45,55-62,112-120,154-160; PowerShell:114-124", "finding": "Original child argv, explicit application, cwd and root ENV remain. No static quote/backslash encoder defect found; actual round trips remain open."},
