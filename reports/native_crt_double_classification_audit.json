    "internal_call": "BFA54B full source sptype; exact original FLD64/PUSH ECX/PUSH ECX/FSTP64 preparation and two POP ECX cleanup. Only original8-byte temporary, no third argument inserted. Child full-width read spans parent EBP-2..EBP+1, including first2 saved-EBP bytes.",
    "frnd": "New assembly-only void cdecl(raw low,raw high); caller removes8 bytes and explicitly consumes/pops ST0. One additional x87 stack slot required; final ECX is high DWORD of binary64 scratch after original two POPs.",
    "original_caller_ABI_compatibility_claim": false
  },
  "semantics": {
    "sptype": "Integer-only exact infinity/quiet-NaN/signaling-NaN discrimination; returns1/2/3/4 respectively,0 otherwise. No x87 operation.",
    "fpclass": "Retains exponent dispatch, actual x87 exceptional FLD/FSTP64 roundtrip before full sptype, original decrement return dispatch, raw integer denormal/sign calculation and exact FLDZ/FCOMP64/FNSTSW/TEST AH44/JP zero path.",
    "fpclass_special_return_dispatch": {
      "sptype_1": "0x200",
      "sptype_2": "0x4",
      "sptype_3": "0x2",
      "remaining": "0x1"
    },
    "frnd": "Exact FLD64/FRNDINT/FSTP64/FLD64, retaining current x87 rounding, control, status, masks and scratch/stack effects.",
    "floating_environment": "No invented environment, restoration, host classification/rounding helper or normalization. fpclass returning paths balance temporary x87 entry. frnd returns one ST0 entry. Hardware exceptions and partial execution are not caught or translated."
