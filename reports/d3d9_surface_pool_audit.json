  "implemented_contract": {
    "canonical_storage": "Caller supplies actual Win32 0x38 owner for 0108DB00. No field initializers alter raw preimages. Companion has references and no automatic native cleanup.",
    "shared_allocator_list": "The same actual AllocatorListDomain/head 00E188B4 used by other recovered pools; actual element has native vtable, previous and next. Companion binds profile00D6193C/virtual0 00B3E390 before construction publishes the node; no private links or registry head.",
    "layout": {
      "00..08": "actual allocator list node",
      "0c..23": "real critical section",
      "24": "recursion count",
      "28": "slab table",
      "2c": "slab count",
      "30": "table capacity",
      "34": "first-free slab index"
    },
    "geometry": {
      "pool_bytes": 56,
      "slot_bytes": 56,
      "surface_bytes": 52,
      "slot_slab_id_offset": 52,
      "slab_bytes": 1860,
      "slots_per_slab": 32,
      "free_indices_offset": 1792,
      "free_count_offset": 1856,
      "initial_table_capacity": 32
    },
    "surface_boundary": "First 0x34 bytes are available to the native surface; actual slot+34 DWORD is the pool slab ID. Constructor/destructor must preserve it; enlarged host companions belong elsewhere.",
    "slab_initialization": "Set freecount32, ushort free indices31..0 and all32 actual slot+34 slab IDs. Preserve other slot bytes and two tail bytes.",
    "allocation": "Use actual singleton_lifetime_allocate/free CRT boundary. Constructor publishes cap32 before128-byte table. Allocate locks/increments, publishes first-free=count, allocates744h slab, initializes with live ID, grows table to2*cap+2 if count==cap, copies active pointers, frees then publishes table, appends raw slab. Pop slot; update first-free; decrement and unlock.",
    "slot_return": "Use actual slot+34 ID, signed32 pointer subtraction divided by38h, append ushort index, reload/increment freecount, lower first-free unsigned, decrement/unlock. No surface destruction or immediate trim.",
    "trim": "No internal lock. Free empty slab, copy last pointer into hole even for last removal, decrement count, rewrite all32 moved IDs, retry same index, recompute lowest free slab.",
    "destructor": "Install pool profile; free all raw slabs and table with complete normal continuations; drain positive explicit recursion with actual LeaveCriticalSection; delete section; install baseD7A0C0 and unlink actual shared element. Preserve stale fields and do not destroy surfaces.",
    "constructor_eh": "MSVC __finally preserves table-free, critical-section cleanup, allocator unlink order from map DF764C/FuncInfoDF7664. EH native bytes are evidence only; full native exception dispatch is not fixture-tested.",
    "allocation_failure": "No allocation-path catch, finally or automatic unlock. Published first-free, grown capacity and held recursion survive an allocation throw; a new slab before failed table growth remains unappended and is not locally freed.",
    "static_lifetime": "Bind one actual canonical owner; static init constructs it and calls supplied CRT atexit (std::atexit default), returns registration result without rollback. Registered callback and allocation/ECX-slot return thunks act on the same pool. Actual storage/domain/companion must outlive callbacks; startup once."
  },
