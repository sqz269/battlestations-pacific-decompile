        "lines": [
          "\t/**",
          "\t * Ensure that absolute path is specified and normalize its format.",
          "\t * An absolute path may start with a windows drive letter (e.g., c:/a/b, /c:/a/b)",
          "\t * or without (e.g., /a/b).  Although for Windows the lack of a drive letter is",
          "\t * not absolute, for consistency with Linux we permit this form which on",
          "\t * Windows will use the default drive for the process. The resulting path",
          "\t * may be transormed to always end with a \"/\" and if started with a drive letter",
          "\t * (e.g., \"c:/\") it will have a \"/\" prepended (e.g., \"/c:/\", both forms",
          "\t * are treated the same by the {@link File} class under Windows).",
          "\t * @param path path to be checked and possibly modified.",
          "\t * @return path to be used",
          "\t * @throws IllegalArgumentException if an invalid path is specified",
          "\t */",
          "\tprivate static String checkAbsolutePath(String path) {",
          "\t\tint scanIndex = 0;",
          "\t\tpath = path.replace('\\\\', '/');",
          "\t\tint len = path.length();",
          "\t\tif (!path.startsWith(\"/\")) {",
          "\t\t\t// Allow paths to start with windows drive letter (e.g., c:/a/b)",
          "\t\t\tif (len >= 3 && hasAbsoluteDriveLetter(path, 0)) {",
          "\t\t\t\tpath = \"/\" + path;",
          "\t\t\t}",
          "\t\t\telse {",
          "\t\t\t\tthrow new IllegalArgumentException(\"absolute path required\");",
          "\t\t\t}",
          "\t\t\tscanIndex = 3;",
          "\t\t}",
          "\t\telse if (len >= 3 && hasDriveLetter(path, 1)) {",
          "\t\t\tif (len < 4 || path.charAt(3) != '/') {",
          "\t\t\t\t// path such as \"/c:\" not permitted",
          "\t\t\t\tthrow new IllegalArgumentException(\"absolute path required\");",
          "\t\t\t}",
          "\t\t\tscanIndex = 4;",
          "\t\t}",
          "\t\tcheckInvalidChar(\"path\", path, scanIndex);",
          "\t\tif (!path.endsWith(\"/\")) {",
          "\t\t\tpath += \"/\";",
          "\t\t}",
          "\t\treturn path;"
        ]
      },
      {
