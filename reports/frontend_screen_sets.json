    "raise_rule": "004f7689: while level > floor, ask the screen's virtual +8h; a true raises the floor to that level, so the first opaque screen in a level decides",
    "request_rule": "004f76a2: bitmap[id] |= (level >= floor)",
    "clear_pass": "004f76d0, all 95 slots: screen && !virtual+4h && !bitmap -> +4h = 0",
