    "00a92290": {
      "convention": "__thiscall(inputManager, int id)",
      "ret": "RET 4",
      "role": "read [manager+10h][id]"
    },
    "004d6410": {
      "convention": "__thiscall(game, int level, vector* ids)",
      "args": "two",
      "ret": "RET 8",
      "role": "the generic input-context level setter that 004d8c00 inlines"
    },
    "00a933f0": {
      "convention": "__thiscall(inputManager, int id, int level)",
      "ret": "RET 8",
      "role": "write [manager+10h][id] and refresh the cached maximum at +20h"
    }
  },
