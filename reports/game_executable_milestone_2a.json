    "phase5": {
      "loader": "load_game_settings_008d8190 over a concrete GameSettingsHost",
      "options_file_read_through": "bsp::PhysicalFile, no write path is used",
      "applied_to_window_creation_00becee0": {
        "arg3_fullscreen": "settings +1e",
        "arg4_vsync": "settings +60 (not a colour-depth selector)",
        "arg7_width": "settings +14",
        "arg8_height": "settings +18",
        "arg9_antialias": "settings +58"
      },
      "device_creation_00b2aeb0": "vsync and antialias reach the renderer init request but d3d9_create_device_prefix_00b2aeb0 models neither PresentationInterval nor MultiSampleType, so they stop there"
    },
    "cli": {
      "--game-root": "SetCurrentDirectoryA before Init so 0073d697 stays the recovered call",
      "--vfs-probe": "repeatable; resolve through 00bdf4c0 and open through 00bdf310; a probe that reads nothing makes the process exit 3"
