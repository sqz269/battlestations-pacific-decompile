  "defects_found": [
    {
      "where": "src/app_bootstrap.cpp apply_options_token",
      "owner": "another packet; not changed here",
      "finding": "008d8190 compares option token names through FUN_00467cc0, which calls BSP_CString_CompareInsensitive, so the comparison is case-insensitive. The reconstruction uses ==. The game's own writer 008d6170 emits 'Vsync ' while the reader literal at 00d15ef4 is 'VSync', so a file the game wrote does not round-trip.",
      "workaround": "GameSettingsBinding canonicalizes recognized token spellings before handing the text to the loader and logs each recase; the validation run recased exactly one token."
    }
  ],
