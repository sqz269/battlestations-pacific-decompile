struct SamplerEntryReleaseCall {
    void* builder; void* row; void* owner; void* shader;
    U target, word, result;
};
static_assert(offsetof(SamplerEntryReleaseCall, shader) == 0xc &&
    offsetof(SamplerEntryReleaseCall, target) == 0x10 &&
    offsetof(SamplerEntryReleaseCall, word) == 0x14 &&
    offsetof(SamplerEntryReleaseCall, result) == 0x18);

// P is ESP after SUB 100h. B5F9C8's saved EBX is exactly P-30h. The
// B3BFD7 input register schedule is EBX=row, EDI=builder, ESI=owner, EBP=0,
// EDX=COM table, EAX=current Release and ECX=previous native SEH link P+D0h.
// This profile overwrites both copies of ECX before reading them. No Source
// return PC or Source caller-frame address is admitted as native preimage.
// The checked current D3D9 helper saves EDI at W; its RtlLeaveCriticalSection
// may replace W with its actual backoff local. Capture W before another call.
// Callee-saved registers/ESP are restored; flags/EAX/ECX/EDX are caller-clobbered.
// This is a bounded normal-return ABI bridge, not Original FH3/SEH support.
__declspec(naked) void __cdecl release_pixel_sampler_entry_word(SamplerEntryReleaseCall*) {
    __asm {
        push ebp
        push ebx
        push esi
        push edi
        sub esp, 100h
        mov edx, [esp+114h]
        mov ebx, [edx+4]
        mov edi, [edx]
        mov esi, [edx+8]
        mov eax, [edx+0ch]
        xor ebp, ebp
        mov [esp-30h], ebx
        lea ecx, [esp+0d0h]
        cmp eax, ebp
        mov edx, [eax]
        push eax
        mov eax, [edx+8]
        mov ecx, [esp+118h]
        mov [ecx+10h], eax
        lea ecx, [esp+0d4h]
        call eax
        mov edx, [esp+114h]
        mov ecx, [esp-30h]
        mov [edx+14h], ecx
        mov [edx+18h], eax
        add esp, 100h
        pop edi
        pop esi
        pop ebx
        pop ebp
        ret
    }
}

bool prepare_sampler_entry_release(Frame& a) noexcept {
    auto& e = a.sampler_entry;
    auto& c = *a.context;
    if (!c.sampler_calls || !e.cached_path || !e.row || !a.pixel_shader || !a.shader_owners[1] ||
        c.load_variants_0108d6f0 || c.source_mode_0108d6f1 || e.cache != c.actual_cache_0108d6ec ||
        !a.pass_registered || !a.shader_registered[1] || e.owner_count_at_constructor != 1) return false;
    e.builder = &a.parent->builder; e.pass = a.pass; e.owner = a.shader_owners[1]; e.shader = a.pixel_shader;
    if (!e.device || read<void*>(c.actual_renderer_00f8d394, 0x1a10) != e.device ||
        read<void*>(e.owner, 8) != e.shader || read<U>(e.owner) != 0x00d62a60 ||
        read<void*>(e.pass, 0x58) != nullptr || !sampler_entry_profile(e)) return false;
    const auto d3d = static_cast<U>(e.d3d9_module);
    const auto* shader_table = read<const void*>(e.shader);
    const auto* device_table = read<const void*>(e.device);
    e.release_target = read<U>(shader_table, 8);
    if (e.release_target != d3d + 0x7eb90 || read<U>(shader_table, 4) != d3d + 0x122490 ||
        read<U>(device_table, 4) != d3d + 0x81990 || read<U>(device_table, 8) != d3d + 0x65bd0 ||
        read<void*>(e.shader, 0x10) != e.device || read<void*>(e.device, 0x24) != e.device ||
        read<U>(e.device, 0x1c) != 1) return false;
    e.shader_count_before = read<U>(e.shader, 8);
    e.device_count_before = read<U>(e.device, 0x38);
    if (e.shader_count_before != 2 || e.device_count_before == 0 || e.device_count_before > 0x7ffffffeu) return false;
    e.profile_matched = true;
    return true;
}

void finish_sampler_entry_release(Frame& a, const NativeMaterialPassShaderSlotsOperation& slot) noexcept {
    auto& e = a.sampler_entry;
    // The retained renderer owns the SAME actual device through this compiler.
    // No independent owner retirement is permitted in the canonical domain.
    // Checked guard constructor always takes argument 1 and calls this same
    // device's AddRef before its final Release. The renderer's retained baseline
    // is positive, so that pair is n -> n+1 -> n, including n==1. Exclude a
    // changed observed count as well as independent retirement/replacement.
    e.known = e.profile_matched && e.release_returned && e.com_release_result == 1 &&
        e.release_target == e.d3d9_module + 0x7eb90 &&
        e.device_count_after == e.device_count_before && e.device_count_after != 0 &&
        e.owner_release_previous_count == 2 && slot.phase == NativeMaterialPassShaderSlotsOperation::Phase::complete &&
        slot.old_identity == nullptr && slot.incoming_identity == e.owner && slot.slot_published &&
        slot.incoming_incremented && slot.incoming_previous_count == 1 && !slot.old_release_entered &&
        e.builder == &a.parent->builder && e.pass == a.pass && e.owner == a.shader_owners[1] &&
        e.shader == a.pixel_shader && read<void*>(e.pass, 0x58) == e.owner &&
        read<void*>(e.owner, 8) == e.shader &&
        read<U>(read<const void*>(e.shader), 8) == e.release_target &&
        read<U>(read<const void*>(e.device), 8) == e.d3d9_module + 0x65bd0 &&
        sampler_entry_profile(e);
}

